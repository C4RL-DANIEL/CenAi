{
  "rewrites": [
    { "source": "/billing/success", "destination": "/billing-success.html" },
    { "source": "/billing/cancel", "destination": "/billing-cancel.html" },
    { "source": "/billing", "destination": "/billing.html" },
    { "source": "/billing/", "destination": "/billing.html" },
    { "source": "/beta", "destination": "/beta.html" },
    { "source": "/beta/", "destination": "/beta.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/reset-password/", "destination": "/reset-password.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://bqkzehozezvepbthglyj.supabase.co https://*.supabase.co; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
      { "key": "Cache-Control", "value": "no-store" }
    ]
  }]
}
