{
  "rewrites": [
    {
      "source": "/pages/:slug",
      "destination": "/page.html?slug=:slug"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/account/",
      "destination": "/account.html"
    },
    {
      "source": "/billing/success",
      "destination": "/billing-success.html"
    },
    {
      "source": "/billing/cancel",
      "destination": "/billing-cancel.html"
    },
    {
      "source": "/billing",
      "destination": "/billing.html"
    },
    {
      "source": "/billing/",
      "destination": "/billing.html"
    },
    {
      "source": "/beta",
      "destination": "/beta.html"
    },
    {
      "source": "/beta/",
      "destination": "/beta.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/reset-password/",
      "destination": "/reset-password.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' data: https:; connect-src 'self' https:; frame-src https:; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}