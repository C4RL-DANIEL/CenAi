{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cenai-website",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
